{
    "name": "nfgarching/core",
    "description": "Basis-Package für Laravel-Anwendungen mit Bootstrap 5 und Livewire: Blade-Komponenten, Layouts, Auth, Navigation-Registries, Props und gemeinsame Traits.",
    "keywords": [
        "laravel",
        "livewire",
        "bootstrap",
        "core"
    ],
    "homepage": "https://github.com/nfgarching/laravel-bootstrap-core",
    "license": "MIT",
    "authors": [
        {
            "name": "Norbert Fröhler",
            "email": "norbert.froehler@gmail.com",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "kyslik/column-sortable": "^8.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "orchestra/testbench": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Nfgarching\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nfgarching\\Core\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nfgarching\\Core\\LibraryServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
